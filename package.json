    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.0",
    "vue-tsc": "^2.2.0"
  }
